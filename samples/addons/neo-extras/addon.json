{
  "id": "neo-extras",
  "name": "Neo Extras",
  "version": "1.0.0",
  "author": "Neo Gentrics",
  "description": "A sample add-on: timeline blocks, an outline export (OPML) and the Solar theme.",
  "themes": [
    {
      "id": "solar",
      "name": "Solar",
      "tone": "light",
      "colors": {
        "page": "#fdf6e3", "desk": "#eee8d5", "text": "#3b4a52", "textSoft": "#53626a", "muted": "#5f6e75", "heading": "#073642",
        "accent": "#b25f00", "accent2": "#2aa198", "accentSoft": "#f5e9cc", "link": "#1f5fa8", "rule": "#e6dfca", "ruleStrong": "#d6ccb0",
        "codeBg": "#f6efdb", "codeBorder": "#e6dcbd", "quoteBar": "#d3b880", "quoteBg": "#f8f0dc", "tableHead": "#f3eacf", "tableStripe": "#faf3df",
        "chrome": "#f7f0de", "chromeBorder": "#e0d6b8"
      }
    }
  ],
  "codeBlocks": [
    { "language": "timeline", "script": "timeline.js" }
  ],
  "exports": [
    { "id": "opml", "name": "Outline (OPML)", "extension": "opml", "script": "opml.js" }
  ]
}
