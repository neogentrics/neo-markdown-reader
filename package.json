{
  "name": "neo-markdown-reader",
  "productName": "Neo Markdown Reader",
  "version": "1.4.0",
  "description": "A beautiful, distraction-free Markdown reader for Windows, macOS and Linux.",
  "author": "Neo Gentrics <author@neogentrics.com>",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "dist:win": "npm run build:renderer && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg --publish never",
    "dist:linux": "npm run build:renderer && electron-builder --linux AppImage --publish never",
    "dev": "node scripts/build-renderer.mjs && electron . samples/showcase.md",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e": "node scripts/build-renderer.mjs && node test/e2e/app.e2e.cjs && node test/e2e/editing.e2e.cjs && node test/e2e/organize.e2e.cjs && node test/e2e/publish.e2e.cjs"
  },
  "build": {
    "appId": "com.neogentrics.markdownreader",
    "productName": "Neo Markdown Reader",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**",
      "dist/**",
      "samples/**",
      "package.json",
      "LICENSE"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn",
          "mdx"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Viewer"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neo Markdown Reader",
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "NeoMarkdownReader-${version}-Setup.exe"
    },
    "portable": {
      "artifactName": "NeoMarkdownReader-${version}-Portable.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage"
      ],
      "artifactName": "NeoMarkdownReader-${version}-linux-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 Neo Gentrics. All rights reserved.",
    "dmg": {
      "artifactName": "NeoMarkdownReader-${version}-mac-${arch}.dmg"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "neogentrics",
        "repo": "neo-markdown-reader",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "docx": "^9.15.1",
    "dompurify": "^3.4.17",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.2.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.1"
  },
  "homepage": "https://github.com/neogentrics/neo-markdown-reader",
  "repository": {
    "type": "git",
    "url": "https://github.com/neogentrics/neo-markdown-reader.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
