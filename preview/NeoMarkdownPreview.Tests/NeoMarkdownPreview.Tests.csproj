<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the preview's Markdown renderer. They run anywhere .NET 8 runs (the renderer has no
       Windows dependencies); the COM preview handler itself is tested on Windows in CI. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../NeoMarkdownPreview/PreviewRenderer.cs" Link="PreviewRenderer.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
